
# BrainBytes Environment Variables
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env

# ── Authentication ──
# Secret key for signing JWT tokens. Use a strong random string in production.
# Generate one with: openssl rand -hex 64
JWT_SECRET=brainbytes-dev-secret-key-change-in-production

# ── AI Service ──
# Hugging Face API token for the AI tutoring service.
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your-huggingface-token-here

# ── Database ───
# MongoDB connection URI.
# - For local dev (containerized Mongo):  mongodb://mongo:27017/brainbytes
# - For MongoDB Atlas (production):        mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/brainbytes?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/brainbytes

# ── Node Environment ────
# development | test | production
NODE_ENV=production

# ── Frontend ───
# Public-facing API URL (used at Next.js build time and runtime).
# - Local dev:  http://localhost:3000
# - Docker:     http://backend:3000  (internal service name)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Docker Registry (for deployment) ───
# GitHub Container Registry credentials (set via GitHub Secrets in CI).
# GHCR_USERNAME=<your-github-username>
# GHCR_TOKEN=<your-github-personal-access-token>
# DOCKER_REGISTRY=ghcr.io

# ── Deployment Target (Oracle Cloud / SSH) ───
# DEPLOY_HOST=<your-vm-public-ip>
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=<path-to-ssh-private-key>
