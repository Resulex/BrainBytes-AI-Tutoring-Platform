# Dockerfile for running Playwright E2E tests in CI
FROM mcr.microsoft.com/playwright:latest

WORKDIR /usr/src/app

# Install Node.js dependencies
COPY package*.json ./
RUN npm ci

# Copy test files
COPY e2e/ ./e2e/
COPY playwright.config.js ./playwright.config.js 2>/dev/null || true

CMD ["npx", "playwright", "test", "--reporter=html,json,junit"]
