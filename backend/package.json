{
  "name": "brainbytes-api",
  "version": "2.0.0",
  "description": "Backend API for BrainBytes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit --detectOpenHandles --runInBand",
    "test:watch": "jest --watch --forceExit --runInBand",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles --runInBand",
    "test:ci": "jest --coverage --forceExit --detectOpenHandles --runInBand --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^5.13.20",
    "node-fetch": "^2.7.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.0.2",
    "prettier": "^3.3.0",
    "socket.io-client": "^4.7.4",
    "supertest": "^6.3.4"
  }
}
